# ── Samaj Darpan environment ─────────────────────────────────────────────
# Copy to `.env` and fill what you have. Everything is optional; the app
# runs in a clearly-labelled local demonstration mode without any keys.

PORT=8787
NODE_ENV=development
SESSION_SECRET=change-me-to-a-long-random-string
# Optional override for Secure session cookie flag (true/false). Defaults to true over HTTPS in production.
COOKIE_SECURE=
# Directory for the local JSON database (db.json). Mount a persistent volume here in production.
DATA_DIR=server/data

# Public Open Government Data (data.gov.in) API key.
# Register free at https://www.data.gov.in/key/register
OGD_API_KEY=
# Comma-separated OGD resource IDs to retrieve. Both values are required for
# live OGD retrieval; otherwise use the administrator CSV/XLSX import.
OGD_RESOURCE_IDS=

# Optional Supabase identity (email verification + Google sign-in).
# When configured, the client uses Supabase Auth and the server verifies
# access tokens against your project's JWKS.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_JWT_ISSUER=

# Demo-mode only: shows password-reset links in the UI instead of emailing.
DEMO_MODE=true

# Opt-in periodic refresh of connectors that expose a documented API.
# Disabled by default so a deployment never makes surprise requests.
ENABLE_AUTO_REFRESH=false
